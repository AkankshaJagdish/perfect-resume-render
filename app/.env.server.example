# PerfectResume server environment variables
# Local DB: if you use `wasp start db`, Wasp provides DATABASE_URL for local dev.
# For external/local Postgres, uncomment and set this value.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perfectresume

# Admin users receive admin privileges when signing up with these emails.
ADMIN_EMAILS=me@example.com,you@example.com

# Google OAuth (required because Google auth is enabled in main.wasp.ts).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP email sender (required because app/src/server/emailSender.wasp.ts uses provider: "SMTP").
SMTP_HOST=smtp.example.com
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_PORT=587

# Dodo Payments (active payment processor).
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-key
DODO_PAYMENTS_ENVIRONMENT=test_mode
PAYMENTS_STARTER_SUBSCRIPTION_PLAN_ID=your-dodo-product-id

# Gemini resume optimization. Set either GEMINI_API_KEY or GEMINI_API_KEYS.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key-one,key-two

# AWS S3 file uploads.
AWS_S3_IAM_ACCESS_KEY=your-aws-access-key-id
AWS_S3_IAM_SECRET_KEY=your-aws-secret-access-key
AWS_S3_FILES_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1

# Plausible analytics used by the admin stats job.
PLAUSIBLE_API_KEY=your-plausible-api-key
PLAUSIBLE_SITE_ID=your-domain.com
PLAUSIBLE_BASE_URL=https://plausible.io/api
